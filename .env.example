# Copy to .env (gitignored). Bun loads it automatically for `bun run upload`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=photos

# Public URL of the bucket (the custom domain connected in the R2 dashboard).
# Used by the site at build time; also set it as a repository variable for the deploy workflow.
VITE_IMG_BASE=https://img.quinnchrest.dev
